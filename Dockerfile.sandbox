FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv git ripgrep make g++ ca-certificates procps tree curl && rm -rf /var/lib/apt/lists/*
ENV HOME=/home/agent PYTHONDONTWRITEBYTECODE=1 PIP_BREAK_SYSTEM_PACKAGES=1 npm_config_cache=/tmp/npm-cache
WORKDIR /workspace
USER 1000:1000
CMD ["/bin/sh"]
